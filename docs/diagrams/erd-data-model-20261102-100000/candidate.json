  "cards": [
    {
      "dot": "rose",
      "title": "一意性で守るルール",
      "items": [
        "favorites の user_id と collected_on の組は一意にして、1日1回を守る",
        "先着は status を条件にした更新で決める",
        "user_id ごとに飛行中は1個という部分一意を付ける",
        "status の値は flying、collected、lost"
      ]
    },
    {
      "dot": "cyan",
      "title": "更新の多い列",
      "items": [
        "plays と pops の複合主キーで、同じ人の二重加算と二重の割るを防ぐ",
        "play_count はSQLの増分で更新する",
        "pops の行があれば、その人には流さない",
        "lat、lng、speed_*、moved_at は5秒ごとに更新するので索引を付けない（HOT更新を保つ）",
        "次の位置は moved_at からの実際の経過時間で計算する"
      ]
    },
    {
      "dot": "amber",
      "title": "図の省略",
      "items": [
        "plays、pops、favorites、auth_tokens から users への線は省略している",
        "wind_grid は他のテーブルと結合しない"
      ]
    }
  ]
